# GasAnalytics — Variáveis de Ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco de Dados Analítico DuckDB
DUCKDB_PATH=data/gold/gas_analytics.duckdb

# Diretórios Medallion
DATA_DIR_RAW=data/raw
DATA_DIR_PROCESSED=data/processed
DATA_DIR_GOLD=data/gold

# APIs Públicas e Fontes Externas
BACEN_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.{codigo}/dados?formato=json
ANP_DADOS_ABERTOS_URL=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos
